# Environment for compose.yaml.
#
# Portainer: paste these into the stack's "Environment variables" section.
# Locally:   cp .env.example .env && docker compose up -d

# ── Image ────────────────────────────────────────────────────────────
# Published to both registries by release.yml, on a v* tag.
#   GHCR        ghcr.io/friedrichrehren/formationstimer-web
#   Docker Hub  docker.io/friedrichrehren/formationstimer-web
FORMATIONSTIMER_IMAGE=ghcr.io/friedrichrehren/formationstimer-web

# Only releases are published, so latest is the newest v* tag. For a rollback
# set an older version (1.0.0) or the sha-… tag of that build — no rebuild
# required.
FORMATIONSTIMER_TAG=latest

# ── Container ────────────────────────────────────────────────────────
FORMATIONSTIMER_CONTAINER_NAME=formationstimer

# Only affects nginx log timestamps; the app itself uses the browser's clock.
TZ=Europe/Berlin

# ── Traefik ──────────────────────────────────────────────────────────
# The external network Traefik and this container share.
FORMATIONSTIMER_NETWORK=proxy

# The host name Traefik routes to this container. It has to be reachable over
# HTTPS — browsers refuse to install a PWA or register a service worker on
# plain HTTP (localhost being the one exception).
FORMATIONSTIMER_HOST=timer.example.com

# Port inside the container. The image's nginx listens on 80.
FORMATIONSTIMER_INTERNAL_PORT=80
