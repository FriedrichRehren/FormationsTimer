# These files end up in a Linux container where sed, grep and nginx read them.
# The repository root sets "* text=auto", so on a Windows checkout they would
# otherwise get CRLF and the cache-version substitution in the Dockerfile would
# stop matching.
*.js      text eol=lf
*.mjs     text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.json    text eol=lf
*.webmanifest text eol=lf
*.svg     text eol=lf
*.conf    text eol=lf
*.yaml    text eol=lf
Dockerfile text eol=lf
*.png     binary
